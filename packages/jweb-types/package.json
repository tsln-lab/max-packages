{
  "name": "@tsln/jweb-types",
  "version": "0.0.0",
  "description": "Type declarations for window.max, the MaxBridge API of web pages loaded in Max's [jweb] object",
  "license": "MIT",
  "author": "Mateo Murphy",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsln-lab/max-packages.git",
    "directory": "packages/jweb-types"
  },
  "keywords": [
    "max",
    "msp",
    "max-msp",
    "max-for-live",
    "jweb",
    "maxbridge",
    "cycling74",
    "typescript",
    "types"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/module-only/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
