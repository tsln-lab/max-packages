{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "packages/**",
      "scripts/**",
      "*.json",
      "*.jsonc",
      "!pnpm-lock.yaml",
      // Generated by pnpm generate:lom
      "!packages/lom-types/index.d.ts",
      "!packages/live-object/src/lom-meta.ts",
      // Build output
      "!packages/*/dist"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      // The scaffolder's templates are Max scripts: Max calls their top-level functions by
      // name, so nothing references them, and the generated project turns this rule off too
      "includes": ["packages/create-max/template/**", "packages/create-max/template-node/**"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ],
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        // Max messages carry arbitrary atoms; the API takes and returns any[] by design
        "noExplicitAny": "off",
        // Handlers may return a number or nothing, which `number | void` states exactly
        "noConfusingVoidType": "off",
        // Empty interfaces are merge points that consuming projects extend
        "noEmptyInterface": "off"
      }
    }
  }
}
